    {
      "id": "focused-known-people",
      "why": "the seam this change is about",
      "cmd": [
        "tests/test_natural_intent.py",
        "tests/test_recipient_handoff.py",
        "tests/test_capability_namespace.py"
      ]
    },
    {
      "id": "goal-seam",
      "why": "slots, runtime, handler and selection \u2014 the spine's own units",
      "cmd": [
        "tests/test_goal_slots.py",
        "tests/test_goal_runtime.py",
        "tests/test_goal_handler.py",
        "tests/test_goal_selection.py"
      ]
    },
    {
      "id": "acceptance",
      "why": "what a STUDENT experiences, end to end, across two tools",
      "cmd": [
        "tests/test_acceptance_cross_tool.py"
      ]
    },
    {
      "id": "boundary",
      "why": "a refusal cannot cross into a provider write",
      "cmd": [
        "tests/test_action_boundary.py",
        "tests/test_authorization_zero_call.py"
      ]
    },
    {
      "id": "authorization-corpus",
      "why": "238 adversarial turns judged at the adapter",
      "cmd": [
        "tests/",
        "-k",
        "authorization"
      ]
    },
    {
      "id": "migration",
      "why": "one head, one lane reservation, no fork",
      "cmd": [
        "tests/test_migration_discipline.py",
        "tests/test_migration_rls_context.py"
      ]
    }
  ],
