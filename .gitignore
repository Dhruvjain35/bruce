# secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# macOS
.DS_Store

# editors
.vscode/
.idea/

# iOS (for later)
app/**/xcuserdata/
app/**/*.xcuserstate
app/**/DerivedData/

# iOS client — xcodegen regenerates the project; don't commit build artifacts/screenshots
ios/build/
ios/Bruce.xcodeproj/
ios/*.png
ios/shots/
ios/**/xcuserdata/

# local Claude Code agent config (never commit)
.claude/

# scripts/mutation_proofs.py stages originals here before mutating. A directory left behind means a
# killed run; the next run restores from it and refuses to start. It must never be committed.
.mutation-backup/
